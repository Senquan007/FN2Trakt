# ---------------- 宿主机路径 ----------------
# 镜像标签（使用离线镜像包时改成对应的 amd64 标签）
FN2TRAKT_IMAGE=fn2trakt:4.1.4

# 宿主机端口（容器内部固定 8080）
FN2TRAKT_HOST_PORT=8080

# 应用数据目录（fn2trakt.db、备份、密钥）
# NAS 示例：/vol1/docker/fn2trakt/data
DATA_DIR=./data

# 飞牛数据库所在目录，容器内只读挂载到 /fntv
# NAS 示例：/vol1/@appdata/trim.media/database
FNTV_DB_DIR=./DB
FNTV_DB_FILE=trimmedia.db

# 运行容器进程的用户（NAS 上可用 id 查看）
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# ---------------- 应用 ----------------
# 留空则自动生成并持久化到 DATA_DIR/.secret_key
FN2TRAKT_SECRET_KEY=

# HTTPS 部署时改为 true
FN2TRAKT_COOKIE_SECURE=false
FN2TRAKT_SESSION_DAYS=30

# 可选：首次启动自动创建管理员（数据库没有用户时生效）
# FN2TRAKT_ADMIN_USERNAME=admin
# FN2TRAKT_ADMIN_PASSWORD=change-me

# 可选：Trakt 应用默认凭据（也可以在后台系统设置里添加）
# FN2TRAKT_TRAKT_CLIENT_ID=
# FN2TRAKT_TRAKT_CLIENT_SECRET=
FN2TRAKT_TRAKT_TRUST_ENV=true

# 定时同步
FN2TRAKT_SYNC_ENABLED=true
FN2TRAKT_SYNC_INTERVAL_MINUTES=5
