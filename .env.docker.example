# ---------- 镜像 ----------
# 预构建多架构镜像；如果你 fork 后自己构建，改成你的 Docker Hub 地址
FN2TRAKT_IMAGE=spikeding/fn2trakt:3.0.0

# ---------- 宿主机端口 ----------
# 容器内部固定 8080
FN2TRAKT_HOST_PORT=8080

# ---------- 宿主机路径 ----------
# 应用数据目录：fn2trakt.db、.secret_key、backups/（必须可写）
# NAS 示例：/vol1/docker/fn2trakt/data
DATA_DIR=./data

# 飞牛数据库所在目录（整个目录，内含 trimmedia.db / -wal / -shm）
# NAS 示例：/vol1/@appdata/trim.media/database
FNTV_DB_DIR=./DB
FNTV_DB_FILE=trimmedia.db

# 容器进程用户，NAS 上用 id -u / id -g 查看
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# ---------- 应用 ----------
# 留空则在 DATA_DIR/.secret_key 自动生成并持久化
# 生产环境建议固定：openssl rand -hex 32
FN2TRAKT_SECRET_KEY=

# 走 HTTPS 反代时设为 true
FN2TRAKT_COOKIE_SECURE=false
FN2TRAKT_SESSION_DAYS=30

# 可选：首次启动自动建管理员（仅当库里没有用户时生效）
# FN2TRAKT_ADMIN_USERNAME=admin
# FN2TRAKT_ADMIN_PASSWORD=change-me

# 定时同步
FN2TRAKT_SYNC_ENABLED=true
FN2TRAKT_SYNC_INTERVAL_MINUTES=5

# 仅在 Trakt 访问需要代理时填写
FN2TRAKT_HTTPS_PROXY=
FN2TRAKT_HTTP_PROXY=
FN2TRAKT_NO_PROXY=localhost,127.0.0.1
