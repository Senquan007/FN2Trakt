# ---- FN2Trakt runtime ----
FN2TRAKT_DATA_DIR=./data
FN2TRAKT_FNTV_DB_PATH=./DB/trimmedia.db

# Set this in production (a random string >= 32 chars).
FN2TRAKT_SECRET_KEY=

# Set true when served over HTTPS.
FN2TRAKT_COOKIE_SECURE=false
FN2TRAKT_SESSION_DAYS=30

# Optional: create the first admin automatically.
# FN2TRAKT_ADMIN_USERNAME=admin
# FN2TRAKT_ADMIN_PASSWORD=change-me

# Optional Trakt app defaults. The settings page overrides these.
# FN2TRAKT_TRAKT_CLIENT_ID=
# FN2TRAKT_TRAKT_CLIENT_SECRET=
FN2TRAKT_TRAKT_API_BASE=https://api.trakt.tv
FN2TRAKT_TRAKT_AUTH_BASE=https://auth.trakt.tv
# Set false to ignore system HTTP(S)_PROXY.
FN2TRAKT_TRAKT_TRUST_ENV=true

# Scheduler defaults (settings page overrides).
FN2TRAKT_SYNC_INTERVAL_MINUTES=5
FN2TRAKT_SYNC_ENABLED=true

# FN2TRAKT_HOST=0.0.0.0
# FN2TRAKT_PORT=8080

TZ=Asia/Shanghai
